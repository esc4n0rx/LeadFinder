# Variáveis opcionais; defina no terminal. Não há carregamento automático de .env.
LEADFINDER_DATABASE=instance/leadfinder.sqlite3
LEADFINDER_HEADLESS=true
# Use chrome ou msedge se preferir um navegador já instalado.
LEADFINDER_BROWSER_CHANNEL=
LEADFINDER_PORT=5000
LEADFINDER_SECURE_COOKIES=false
# Opcionais para a integração de WhatsApp:
LEADFINDER_NODE_BINARY=
LEADFINDER_WHATSAPP_BROWSER=
